data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained model artifacts
models/*.pkl
!models/.gitkeep

# Jupyter checkpoints (usually already covered by Python template, but just in case)
.ipynb_checkpoints/

# Environment
venv/
.venv/
env/

# OS files
.DS_Store
Thumbs.db

# Docker
*.log